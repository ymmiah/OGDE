{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogde.org/schemas/ogde-finding-1.json",
  "title": "OGDE local findings document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "findings": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "finding_id", "confidence", "component", "vulnerability", "signals", "affected", "evidence", "limitations"],
      "properties": {
        "schema_version": { "const": 1 },
        "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "confidence": { "enum": ["confirmed", "probable", "contested"] },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purl", "name", "version"],
          "properties": {
            "purl": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "vulnerability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "severity"],
          "properties": {
            "id": { "type": "string" },
            "severity": { "enum": ["critical", "high", "medium", "low", "unknown"] }
          }
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kev_listed", "epss", "internet_exposed"],
          "properties": {
            "kev_listed": { "type": "boolean" },
            "epss": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "internet_exposed": { "type": "boolean" }
          }
        },
        "affected": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "record_id", "digest_sha256"],
            "properties": {
              "source": { "type": "string" },
              "record_id": { "type": "string" },
              "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string" }
        }
      }
    }
  }
}
